{
  // Compilation des tests sous node:test (runtime Node ESM, nodenext). Distinct de tsconfig.json
  // (build Next, moduleResolution bundler). Émet vers build-test/ . EXCLUS : `src/app` (App Router,
  // validé via `next build` + sonde HTTP). La baseline `base` n'a pas de modules SERVER-ONLY sous
  // node:test ; les capabilities composées qui en ajoutent (ex. `src/core/auth/server` liant
  // `next/headers`) les excluent via leur propre variante de ce fichier.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "build-test",
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["src/core/**/*", "src/shared/**/*", "src/features/**/*", "test/**/*"],
  "exclude": ["node_modules", ".next", "build-test", "src/app"]
}
