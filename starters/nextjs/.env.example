# =============================================================================
# Web Core Next.js — variables d'environnement (exemple, sans secret réel)
# Copier en `.env.local` (non versionné).
# Aucune variable n'est requise pour le build, le lint ou les tests.
# =============================================================================

# Environnement applicatif logique (public, non secret).
APP_ENV=development

# Nom d'application exposé au client (public).
NEXT_PUBLIC_APP_NAME=Enistère

# URL canonique publique de l'application (sitemap.xml, robots.txt). Facultative en dev.
# NEXT_PUBLIC_APP_URL=https://enistere.dev

# -----------------------------------------------------------------------------
# Intégration API publique (Web 2) — endpoints Health uniquement (aucune auth).
# Facultatives : sans elles, l'UI affiche « API non configurée » et n'émet aucune requête.
# -----------------------------------------------------------------------------

# URL API PUBLIQUE consommée par le NAVIGATEUR (préfixe NEXT_PUBLIC_ = exposé au client).
# Valeur publique par définition : AUCUN secret/token ici. http/https, URL absolue, sans credentials.
# NEXT_PUBLIC_API_URL=https://api.exemple.test

# URL API INTERNE, SERVEUR UNIQUEMENT (rendu/préchargement SSR). Préférée côté serveur si présente.
# Ne JAMAIS préfixer NEXT_PUBLIC_ (sinon fuite côté client). http/https, URL absolue, sans credentials.
# API_INTERNAL_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Auth/Files BFF — origines autorisées pour les requêtes mutatives (anti-CSRF,
# complément du double-submit). Liste séparée par des virgules d'origines EXACTES
# (scheme://host[:port]), sans wildcard ni credentials.
# REQUISE dès que les flux Auth/Files mutatifs sont utilisés : si absente, la validation
# Origin/Referer est fail-closed et TOUTE mutation (login/refresh/logout/download-url)
# est refusée en 403. cf. docs/csrf.md.
# -----------------------------------------------------------------------------
# WEB_ALLOWED_ORIGINS=http://localhost:3100
