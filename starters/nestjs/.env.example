NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/enistere_api_core?schema=public

# Secrets JWT — valeurs de développement non sensibles. Ne jamais committer de secret réel.
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret

# Durées de vie en SECONDES.
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=1209600

# Secret dédié à l'empreinte HMAC des refresh tokens (distinct des secrets JWT).
REFRESH_TOKEN_HASH_SECRET=replace-with-refresh-hash-secret

# Paramètres Argon2id (memoryCost en KiB). Valeurs INDICATIVES, à valider par benchmark
# sur l'environnement cible (voir ADR-039). Ne pas considérer comme optimales.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Rate limiting du login : nombre de tentatives autorisées par fenêtre (TTL en secondes).
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_TTL=60

# Rate limiting du refresh (fenêtre indépendante du login).
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_TTL=60

# Politique fichiers (ADR-007). Taille max en OCTETS.
FILE_MAX_SIZE_BYTES=10485760
FILE_ORIGINAL_NAME_MAX_LENGTH=255

# Stockage objet S3-compatible (MinIO/S3). Credentials = SECRETS, ne jamais committer de valeur réelle.
# Le scheme de S3_ENDPOINT (http/https) détermine TLS (pas de variable S3_USE_SSL séparée).
# S3_FORCE_PATH_STYLE=true requis pour MinIO ; false pour AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=enistere-files
S3_FORCE_PATH_STYLE=true

# Rate limiting de l'upload (fenêtre dédiée, TTL en secondes).
FILES_UPLOAD_RATE_LIMIT=20
FILES_UPLOAD_RATE_TTL=60

# Durée de vie des URLs signées de LECTURE, en SECONDES. Bornée serveur (min 30, max 900).
# Jamais une URL de plusieurs heures/jours en V1. Le client ne contrôle pas cette durée.
FILES_SIGNED_READ_URL_TTL_SECONDS=300

# Rate limiting de la génération d'URLs signées de téléchargement (fenêtre dédiée, TTL en secondes).
FILES_DOWNLOAD_URL_RATE_LIMIT=30
FILES_DOWNLOAD_URL_RATE_TTL=60

# Cycle de vie / réconciliation fichiers (Upload 4). Durées en SECONDES ; batch en nb d'éléments.
# Les valeurs finales relèvent des projets dérivés et des contraintes légales/rétention.
FILES_PENDING_EXPIRATION_SECONDS=86400          # PENDING au-delà = abandonné (candidat REJECTED)
FILES_REJECTED_RETENTION_SECONDS=604800         # conservation métadonnée des REJECTED
FILES_DELETED_METADATA_RETENTION_SECONDS=7776000 # conservation métadonnée des DELETED (audit/historique)
FILES_ORPHAN_MIN_AGE_SECONDS=86400              # âge minimal avant de supprimer un objet orphelin
FILES_RECONCILIATION_BATCH_SIZE=100             # limite d'éléments traités par exécution

# Quotas par propriétaire (Upload 5). `0` = ILLIMITÉ. Comptent les fichiers actifs
# (PENDING/UPLOADED/VALIDATED/QUARANTINED) ; pas les REJECTED/DELETED.
FILES_OWNER_MAX_ACTIVE_FILES=0                  # nombre max de fichiers actifs par propriétaire
FILES_OWNER_MAX_TOTAL_BYTES=0                   # taille active cumulée max par propriétaire (octets)

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sécurité HTTP transverse. Limites des body parsers (format Express). Le multipart est borné
# séparément (FILE_MAX_SIZE_BYTES + limites Multer). Ne pas mettre de valeur arbitrairement élevée.
JSON_BODY_LIMIT=1mb
URL_ENCODED_BODY_LIMIT=1mb
# Proxys de confiance devant l'API (Traefik/Cloud Core). 0 = aucun (X-Forwarded-For ignoré).
# Mettre le nombre de proxys réellement traversés ; ne jamais activer une confiance aveugle.
TRUST_PROXY_HOPS=0

# Logging structuré (ADR-040). Logs JSON sur stdout (HTTP) / stderr (CLI) ; collecte = Cloud Core.
SERVICE_NAME=api-nestjs-core
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=false                    # pretty-print DEV uniquement ; forcé à false en production
LOG_HTTP_ENABLED=true               # log unique de fin de requête (méthode, route normalisée, statut, durée)
LOG_HEALTH_SUCCESS_ENABLED=false    # logs de succès des sondes /health/* (réduits par défaut)
