NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/enistere_api_core?schema=public

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sécurité HTTP transverse. Limites des body parsers (format Express).
# Ne pas mettre de valeur arbitrairement élevée.
JSON_BODY_LIMIT=1mb
URL_ENCODED_BODY_LIMIT=1mb
# Proxys de confiance devant l'API (Traefik/Cloud Core). 0 = aucun (X-Forwarded-For ignoré).
# Mettre le nombre de proxys réellement traversés ; ne jamais activer une confiance aveugle.
TRUST_PROXY_HOPS=0

# Logging structuré (ADR-040). Logs JSON sur stdout (HTTP) / stderr (CLI) ; collecte = Cloud Core.
SERVICE_NAME=api-nestjs-core
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=false                    # pretty-print DEV uniquement ; forcé à false en production
LOG_HTTP_ENABLED=true               # log unique de fin de requête (méthode, route normalisée, statut, durée)
LOG_HEALTH_SUCCESS_ENABLED=false    # logs de succès des sondes /health/* (réduits par défaut)

# Les variables des capabilities composées (Auth, ...) sont ajoutées à la suite
# de ce fichier par la Factory, à partir des déclarations de leur overlay.
