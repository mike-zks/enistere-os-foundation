{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Statut applicatif général.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/HealthResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Statut applicatif général.",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "health_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Le processus répond.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/LivenessResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Liveness : le processus répond (aucune dépendance externe).",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Dépendances dures disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReadinessResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Une dépendance dure est indisponible (réponse générique).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Readiness : dépendances dures disponibles (PostgreSQL).",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "Enistere API Core NestJS",
    "description": "Contrat OpenAPI canonique du API Core NestJS V1 — source de vérité des API publiques (ADR-016).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "api-nestjs-core"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-09T12:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ]
      },
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live"
            ],
            "example": "live"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up"
            ],
            "example": "up"
          }
        },
        "required": [
          "database"
        ]
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ],
            "example": "ready"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false,
            "description": "Toujours false pour une réponse d’erreur."
          },
          "statusCode": {
            "type": "number",
            "example": 404,
            "description": "Code de statut HTTP."
          },
          "message": {
            "type": "string",
            "example": "File not found.",
            "description": "Message générique non sensible."
          },
          "errorCode": {
            "type": "string",
            "example": "FILE_NOT_FOUND",
            "description": "Code d’erreur applicatif stable."
          },
          "details": {
            "type": "object",
            "nullable": true,
            "description": "Détails structurés optionnels (ex. erreurs de validation). Jamais de secret ni de stack.",
            "example": null
          },
          "path": {
            "type": "string",
            "example": "/files/123",
            "description": "Chemin de la requête."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-09T12:00:00.000Z"
          },
          "requestId": {
            "type": "string",
            "description": "Identifiant de corrélation de la requête (en-tête X-Request-Id). Pas une donnée de sécurité.",
            "example": "b3f1c2d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d"
          }
        },
        "required": [
          "success",
          "statusCode",
          "message",
          "errorCode",
          "path",
          "timestamp"
        ]
      }
    }
  }
}
