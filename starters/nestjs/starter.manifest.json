{
  "schemaVersion": "2",
  "id": "nestjs",
  "kind": "api",
  "framework": "NestJS",
  "baseline": {
    "contractVersion": "2.0.0",
    "familyContract": "api/2.0.0"
  },
  "commands": {
    "install": [
      "npm",
      "ci"
    ],
    "dev": [
      "npm",
      "run",
      "start:dev"
    ],
    "test": [
      "npm",
      "test"
    ],
    "build": [
      "npm",
      "run",
      "build"
    ],
    "verify": [
      "npm",
      "run",
      "openapi:check"
    ]
  },
  "composition": {
    "model": "modular",
    "readyCapabilities": [
      "auth",
      "rbac",
      "files"
    ],
    "plannedCapabilities": []
  },
  "deployment": {
    "dockerfile": "Dockerfile",
    "healthPath": "/health"
  }
}
