{
  "name": "@enistere/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Socle de design tokens Enistere (agnostique, versionné, exportable). Source de vérité UI — ADR-008/009/010. Aucun composant, aucun framework UI.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./generated/css/tokens.css",
    "./tokens.json": "./generated/tokens.json"
  },
  "files": [
    "dist",
    "generated",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test build/test/test/*.test.js",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage build/test/test/*.test.js",
    "tokens:validate": "npm run build && node scripts/validate-tokens.mjs",
    "tokens:generate": "npm run build && node scripts/generate-tokens.mjs",
    "tokens:check": "npm run build && node scripts/check-generated.mjs",
    "pack:check": "npm pack --dry-run",
    "clean": "node -e \"const f=require('node:fs');for(const d of ['dist','build'])f.rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
