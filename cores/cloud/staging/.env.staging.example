# =============================================================================
# Cloud Core 6 — STAGING (exemple, AUCUN secret réel). Copier en `.env.staging`
# (jamais versionné) sur le serveur staging et remplacer chaque `CHANGE_ME`.
# Générer les secrets HORS dépôt :  openssl rand -base64 48
# =============================================================================

# --- Images GHCR (tags IMMUABLES — jamais `latest`) ---------------------------
# Tag recommandé : sha-<commit> (immuable). Voir cores/cloud/docs/GHCR_REGISTRY_GUIDE.md.
GHCR_API_IMAGE=ghcr.io/<owner>/<repo>/api-nestjs:sha-CHANGE_ME
GHCR_WEB_IMAGE=ghcr.io/<owner>/<repo>/web-nextjs:sha-CHANGE_ME

# --- Ports hôte (exposition staging) ------------------------------------------
WEB_HOST_PORT=3100          # navigateur → Web
API_HOST_PORT=3101          # (debug/health) → API ; le Web parle à l'API en réseau interne
MINIO_HOST_PORT=9000        # DOIT être joignable par le NAVIGATEUR (URLs signées) — voir note S3 ci-dessous
MINIO_CONSOLE_PORT=9001     # console MinIO (à protéger / ne pas exposer publiquement)
# PostgreSQL : NON exposé sur l'hôte par défaut (réseau interne uniquement).

# --- PostgreSQL (staging jetable au départ) -----------------------------------
POSTGRES_DB=enistere_staging
POSTGRES_USER=enistere_app          # utilisateur applicatif dédié (PAS superuser)
POSTGRES_PASSWORD=CHANGE_ME

# --- MinIO (staging) ----------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=enistere-staging-files

# --- API (NestJS) — variables RUNTIME (injectées côté serveur uniquement) -----
NODE_ENV=production
DATABASE_URL=postgresql://enistere_app:CHANGE_ME@postgres:5432/enistere_staging?schema=public
JWT_ACCESS_SECRET=CHANGE_ME          # openssl rand -base64 48  (>= 32 chars)
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=1209600
REFRESH_TOKEN_HASH_SECRET=CHANGE_ME
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
FILE_MAX_SIZE_BYTES=10485760
FILE_ORIGINAL_NAME_MAX_LENGTH=255
# S3_ENDPOINT : l'URL signée de téléchargement pointe vers CET hôte → il doit être
# joignable par le NAVIGATEUR **et** par le conteneur API. En staging mono-serveur,
# utiliser l'adresse publique du serveur + MINIO_HOST_PORT (ex. http://staging.example:9000)
# ou un domaine MinIO. NE PAS utiliser http://minio:9000 (non résolu par le navigateur).
S3_ENDPOINT=http://CHANGE_ME:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME           # = MINIO_ROOT_USER (ou clé applicative dédiée)
S3_SECRET_ACCESS_KEY=CHANGE_ME       # = MINIO_ROOT_PASSWORD
S3_FORCE_PATH_STYLE=true
FILES_SIGNED_READ_URL_TTL_SECONDS=300
# Origines autorisées (CSRF/CORS) = origine PUBLIQUE du Web en staging.
CORS_ORIGINS=http://CHANGE_ME:3100
LOG_LEVEL=info
LOG_PRETTY=false
SERVICE_NAME=api-nestjs-core

# --- Web (Next.js) — RUNTIME --------------------------------------------------
# APP_ENV : staging HTTP → laisser `staging` (cookies non-Secure, compatibles HTTP).
#           staging HTTPS (recommandé) → mettre `production` (cookies `__Host-`/Secure).
APP_ENV=staging
# API_INTERNAL_URL : SERVEUR uniquement (Web → API en réseau interne). JAMAIS NEXT_PUBLIC_.
API_INTERNAL_URL=http://api:3000
# NEXT_PUBLIC_API_URL : PUBLIC (navigateur → API, Health). Origine publique de l'API.
# ⚠ Inliné au BUILD de l'image Web : pour le figer par environnement il faut builder par env,
#   sinon laisser vide (Health navigateur désactivé ; SSR Health via API_INTERNAL_URL).
NEXT_PUBLIC_API_URL=
# Origines autorisées pour les mutations BFF (login/refresh/logout/download-url).
WEB_ALLOWED_ORIGINS=http://CHANGE_ME:3100
