# =============================================================================
# Cloud Core 10 — STAGING RÉEL (Traefik + Let's Encrypt + HTTPS).
# Supercède le schéma CC6 (ports hôte exposés).
# Aucun secret réel ici — copier en `.env.staging` sur le serveur, chmod 600.
# Générer les secrets HORS dépôt :  openssl rand -base64 48
# Compose cible : docker-compose.cc10.yml
# =============================================================================

# --- Images GHCR (tags IMMUABLES — jamais `latest`) ---------------------------
# Tag à utiliser : sha du dernier commit main vérifié (≥ sha-d1e6242 pour CC8).
GHCR_API_IMAGE=ghcr.io/mike-zks/enistere-os-foundation/api-nestjs:sha-CHANGE_ME
GHCR_WEB_IMAGE=ghcr.io/mike-zks/enistere-os-foundation/web-nextjs:sha-CHANGE_ME

# --- Ports hôte : AUCUN en CC10 (Traefik gère 80/443 via labels Docker) ------
# WEB_HOST_PORT / API_HOST_PORT / MINIO_HOST_PORT / MINIO_CONSOLE_PORT : supprimés.
# PostgreSQL : NON exposé (réseau interne uniquement).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=enistere_staging
POSTGRES_USER=enistere
POSTGRES_PASSWORD=CHANGE_ME

# --- MinIO (staging) ----------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=enistere-staging-files

# --- API (NestJS) — variables RUNTIME -----------------------------------------
NODE_ENV=production
DATABASE_URL=postgresql://enistere:CHANGE_ME@postgres:5432/enistere_staging?schema=public
JWT_ACCESS_SECRET=CHANGE_ME          # openssl rand -base64 48  (>= 32 chars)
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=604800
REFRESH_TOKEN_HASH_SECRET=CHANGE_ME
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
FILE_MAX_SIZE_BYTES=52428800
FILE_ORIGINAL_NAME_MAX_LENGTH=255
# CC10 : S3_ENDPOINT = URL HTTPS publique via Traefik (Option B).
# Presigned URLs navigateur = https://s3-staging.enistere.com/...
# API → MinIO : résolu via extra_hosts → reverse proxy local (évite une sortie CDN).
S3_ENDPOINT=https://s3-staging.enistere.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME           # = MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=CHANGE_ME       # = MINIO_ROOT_PASSWORD
S3_FORCE_PATH_STYLE=true
FILES_SIGNED_READ_URL_TTL_SECONDS=300
CORS_ORIGINS=https://staging.enistere.com
LOG_LEVEL=info
LOG_PRETTY=false
SERVICE_NAME=enistere-api

# --- Web (Next.js) — RUNTIME --------------------------------------------------
# HTTPS → APP_ENV=production (cookies __Host- / Secure).
APP_ENV=production
API_INTERNAL_URL=http://api:3000
# NEXT_PUBLIC_API_URL : inliné au build → laisser vide (Health SSR via API_INTERNAL_URL).
NEXT_PUBLIC_API_URL=
WEB_ALLOWED_ORIGINS=https://staging.enistere.com
