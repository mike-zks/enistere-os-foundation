{
  "name": "@enistere/web-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Web Core Next.js (App Router) — Enistere. Consomme @enistere/ui-kit ; API publique (Health) + TanStack Query (server state) ; BFF Auth (login/refresh/logout/csrf) + état de session/autorisations (me/authorization, useSession/useAuthorization). Aucune route protégée ni middleware.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "build": "next build --webpack",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage build-test/test/*.test.js",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "clean": "node -e \"const f=require('node:fs');for(const d of ['.next','build-test'])f.rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@enistere/api-client-fetch": "*",
    "@enistere/api-contracts": "*",
    "@enistere/ui-kit": "*",
    "@tanstack/react-query": "^5.101.0",
    "next": "^16.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.7",
    "global-jsdom": "^25.0.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0"
  }
}
