# =============================================================================
# Web Core Next.js — variables d'environnement (exemple, sans secret réel)
# Copier en `.env.local` (non versionné). Web 1 : aucune variable n'est requise.
# =============================================================================

# Environnement applicatif logique (public, non secret).
APP_ENV=development

# Nom d'application exposé au client (public).
NEXT_PUBLIC_APP_NAME=Enistère

# -----------------------------------------------------------------------------
# Web 1 : AUCUN appel API. Les variables ci-dessous sont commentées (réservées V2).
# -----------------------------------------------------------------------------

# URL API publique consommée par le navigateur (préfixe NEXT_PUBLIC_ = exposé au client).
# NEXT_PUBLIC_API_URL=https://api.exemple.test

# URL API interne, SERVEUR UNIQUEMENT. Ne JAMAIS préfixer NEXT_PUBLIC_ (sinon fuite côté client).
# Aucun secret/token ne doit être stocké dans une variable NEXT_PUBLIC_*.
# API_INTERNAL_URL=http://localhost:3000
