{
  // Compilation des tests sous node:test (runtime Node ESM, nodenext). Distinct de tsconfig.json
  // (build Next, moduleResolution bundler). Émet vers build-test/ ; src/app est EXCLU : les
  // fichiers App Router (CSS, layout) sont validés via `next build` + sonde HTTP, pas via node:test.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "build-test",
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["src/core/**/*", "src/shared/**/*", "src/features/**/*", "test/**/*"],
  "exclude": ["node_modules", ".next", "build-test", "src/app"]
}
