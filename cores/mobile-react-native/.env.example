# Enistere Mobile Starter — public environment variables only.
#
# SECURITY: Only EXPO_PUBLIC_* values are exposed to the app bundle. They are
# PUBLIC by definition and are inlined at build time. NEVER put secrets, API
# keys, or private credentials here — those belong on the backend / CI secrets.
#
# Copy this file to `.env` (gitignored) and adjust values per environment.

# Logical environment name: local | staging | production
EXPO_PUBLIC_APP_ENV=local

# Base URL of the API Core (NestJS). No trailing slash.
# Examples:
#   local    -> http://localhost:3000
#   staging  -> https://staging-api.example.com
#   prod     -> https://api.example.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional: API request timeout in milliseconds (defaults to 15000 if unset).
EXPO_PUBLIC_API_TIMEOUT_MS=15000
