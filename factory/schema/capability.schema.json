{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enistere.com/schemas/capability/v2",
  "title": "Enistere Capability Manifest v2",
  "description": "Closed, provider-neutral contract for an optional, composable, targetable and versioned capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "requires",
    "conflicts",
    "responsibilities",
    "contracts",
    "primitives",
    "configuration",
    "targets",
    "migrations",
    "conformance"
  ],
  "properties": {
    "schemaVersion": { "const": "2" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "responsibilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    },
    "primitives": {
      "type": "array",
      "items": { "$ref": "#/$defs/primitive" }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/configOption" }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nestjs", "spring", "fastapi", "nextjs", "angular", "react-native", "flutter"],
      "properties": {
        "nestjs": { "$ref": "#/$defs/target" },
        "spring": { "$ref": "#/$defs/target" },
        "fastapi": { "$ref": "#/$defs/target" },
        "nextjs": { "$ref": "#/$defs/target" },
        "angular": { "$ref": "#/$defs/target" },
        "react-native": { "$ref": "#/$defs/target" },
        "flutter": { "$ref": "#/$defs/target" }
      }
    },
    "migrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/migration" }
    },
    "conformance": {
      "type": "array",
      "items": { "$ref": "#/$defs/conformance" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "kind": { "enum": ["api", "event", "schema", "ui"] }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "requirement", "purposes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "relational-database",
            "document-database",
            "cache",
            "object-storage",
            "content-repository",
            "queue",
            "broker",
            "mail",
            "push",
            "search",
            "telemetry-backend",
            "secrets"
          ]
        },
        "requirement": { "enum": ["required", "optional"] },
        "purposes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ready", "planned", "unsupported", "not-applicable"] },
        "mode": { "enum": ["built-in", "overlay"] },
        "adapter": { "$ref": "#/$defs/adapter" },
        "contracts": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "primitives": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "deploymentModes": {
          "type": "array",
          "items": { "enum": ["embedded", "dedicated-service", "shared-service"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "migrations": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "conformance": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "ready" } }
          },
          "then": {
            "required": [
              "mode",
              "adapter",
              "contracts",
              "primitives",
              "deploymentModes",
              "migrations",
              "conformance"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["mode"] },
                { "required": ["adapter"] },
                { "required": ["contracts"] },
                { "required": ["primitives"] },
                { "required": ["deploymentModes"] },
                { "required": ["migrations"] },
                { "required": ["conformance"] }
              ]
            }
          }
        }
      ]
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "kind", "strategy", "path", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "enum": ["nestjs", "spring", "fastapi", "nextjs", "angular", "react-native", "flutter"] },
        "kind": { "enum": ["database", "data", "index", "configuration"] },
        "strategy": { "enum": ["additive", "transform", "rebuild"] },
        "path": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "level", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "enum": ["nestjs", "spring", "fastapi", "nextjs", "angular", "react-native", "flutter"] },
        "level": { "enum": ["unit", "integration", "contract", "e2e"] },
        "evidence": { "enum": ["overlay-verification", "golden-runtime", "repository-test"] }
      }
    },
    "configOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["enum", "string", "boolean", "integer"] },
        "values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "default": {},
        "required": { "type": "boolean" },
        "sensitive": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["values"] },
          "else": { "not": { "required": ["values"] } }
        }
      ]
    }
  }
}
