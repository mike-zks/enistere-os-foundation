{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enistere.com/schemas/conformance-report/v2",
  "title": "Enistere Conformance Report v2",
  "type": "object",
  "required": ["schemaVersion", "families", "contract", "generatedFrom", "evaluation", "apps"],
  "properties": {
    "schemaVersion": { "const": "2" },
    "families": { "type": "array", "uniqueItems": true, "items": { "enum": ["api", "web", "mobile"] } },
    "contract": {
      "type": "object",
      "required": ["id", "version", "source"],
      "properties": {
        "id": { "const": "platform-baseline" },
        "version": { "const": "2.0.0" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generatedFrom": { "type": "object" },
    "evaluation": { "const": "structural" },
    "apps": { "type": "array" },
    "scan": { "type": "object" },
    "summary": { "type": "object" }
  },
  "additionalProperties": false
}
