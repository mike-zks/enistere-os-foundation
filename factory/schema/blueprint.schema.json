{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enistere.com/schemas/blueprint/v1",
  "title": "Enistere Project Blueprint",
  "type": "object",
  "required": ["version", "project", "topology", "designSystem", "domain", "capabilities", "deployment"],
  "oneOf": [
    { "required": ["stack"], "not": { "required": ["applications"] } },
    { "required": ["applications"], "not": { "required": ["stack"] } }
  ],
  "properties": {
    "version": { "const": "1" },
    "profile": {
      "description": "Optional named composition this blueprint claims. When present, the blueprint's stack and capabilities must match the profile exactly, and a planned profile is refused. Profiles always include an API: web-only and mobile-only names are rejected.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "project": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      },
      "additionalProperties": false
    },
    "topology": { "const": "monorepo" },
    "designSystem": { "type": "boolean", "default": true },
    "stack": {
      "description": "Single-surface sugar: one API and at most one web and one mobile. Desugars to the canonical applications model.",
      "type": "object",
      "required": ["api"],
      "properties": {
        "api": { "enum": ["nestjs", "spring", "fastapi"] },
        "web": { "enum": ["nextjs", "angular", null] },
        "mobile": { "enum": ["react-native", "flutter", null] }
      },
      "additionalProperties": false
    },
    "applications": {
      "description": "Canonical model: the deployable applications this project composes. An API (kind: api) is mandatory. Multiple official web/mobile clients on one backend are generatable. Multiple backend authorities are representable and resolved as PLANNED; worker/gateway/bff remain future kinds.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "runtime"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "kind": { "enum": ["api", "web", "mobile", "worker", "gateway", "bff"] },
          "runtime": { "enum": ["nestjs", "spring", "fastapi", "nextjs", "angular", "react-native", "flutter"] },
          "audience": { "type": "string", "minLength": 1 },
          "consumes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "architecture": {
      "description": "System profile and independent topology dimensions. `style` is deprecated migration input and is never emitted by the canonical model.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["backend-service", "product-platform", "distributed-platform", "service-ecosystem", "api", "monolith", "multi-client", "modular-distributed", "microservices"] },
        "style": { "enum": ["monolith", "modular-monolith", "microservices"] },
        "evolutionTarget": { "enum": ["backend-service", "product-platform", "distributed-platform", "service-ecosystem", "api", "monolith", "multi-client", "modular-distributed", "microservices"] },
        "clients": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "enum": ["none", "single", "multiple"] } }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style"],
          "properties": { "style": { "enum": ["modular-monolith", "distributed-services", "microservices"] } }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coupling"],
          "properties": { "coupling": { "enum": ["coordinated", "partially-independent", "independent"] } }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownership"],
          "properties": { "ownership": { "enum": ["shared", "bounded-context", "per-service"] } }
        },
        "communication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary"],
          "properties": { "primary": { "enum": ["synchronous", "event-driven", "hybrid"] } }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maturity"],
          "properties": { "maturity": { "enum": ["standard", "advanced", "distributed"] } }
        }
      }
    },
    "domain": {
      "type": "object",
      "required": ["entities"],
      "properties": { "entities": { "type": "array" } },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "description": "Optional product capabilities. Legacy v1 input may contain base; ingestion removes it because the Platform Baseline is implicit.",
      "items": { "enum": ["base", "auth", "rbac", "files"] },
      "uniqueItems": true
    },
    "deployment": {
      "type": "object",
      "required": ["environments"],
      "properties": {
        "environments": {
          "type": "array",
          "items": { "enum": ["local", "staging"] },
          "contains": { "const": "local" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
