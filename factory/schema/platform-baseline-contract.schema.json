{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enistere.com/schemas/platform-baseline-contract/v1",
  "title": "Enistere Platform Baseline Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "common", "families"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "const": "platform-baseline" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "common": { "$ref": "#/$defs/contract" },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "web", "mobile"],
      "properties": {
        "api": { "$ref": "#/$defs/contract" },
        "web": { "$ref": "#/$defs/contract" },
        "mobile": { "$ref": "#/$defs/contract" }
      }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "invariants"],
      "properties": {
        "contractVersion": { "type": "string", "pattern": "^(common|api|web|mobile)/\\d+\\.\\d+\\.\\d+$" },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    }
  }
}
