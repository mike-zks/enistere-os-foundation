          "deletion is idempotent (second DELETE → 204)",
          "a user without files.delete cannot delete → 403"
        ]
      }
    ],
    "FILES-AUTHORITY-008": [
      {
        "kind": "test",
        "source": "files/test/files-lifecycle.e2e-spec.ts",
        "materialized": "test/files-lifecycle.e2e-spec.ts",
        "contains": [
          "quarantines a validated file (admin, no ownership), blocking download until restore",
          "quarantine requires files.quarantine (owner without it → 403)"
        ]
      }
    ],
    "FILES-AUTHORITY-009": [
      {
        "kind": "test",
        "source": "files/test/files-maintenance.e2e-spec.ts",
        "materialized": "test/files-maintenance.e2e-spec.ts",
        "contains": [
          "withLock refuses a concurrent maintenance run (MaintenanceLockBusyError)",
          "purges an old DELETED row only when its object is absent (keeps + signals otherwise)"
        ]
      }
    ],
    "FILES-AUTHORITY-010": [
      {
        "kind": "test",
        "source": "files/test/files-maintenance.e2e-spec.ts",
        "materialized": "test/files-maintenance.e2e-spec.ts",
        "contains": [
