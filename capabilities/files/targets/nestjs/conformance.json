        "contains": [
          "returns only files owned by the requesting user (ownership isolation)",
          "excludes DELETED files from the list",
          "returns files in stable createdAt desc order",
          "respects limit and returns nextOffset when more results exist"
        ]
      }
    ],
    "FILES-AUTHORITY-007": [
      {
        "kind": "test",
        "source": "files/test/files-lifecycle.e2e-spec.ts",
        "materialized": "test/files-lifecycle.e2e-spec.ts",
        "contains": [
