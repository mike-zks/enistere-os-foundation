          "rejects an upload without a token (401)"
        ]
      }
    ],
    "FILES-AUTHORITY-002": [
      {
        "kind": "test",
        "source": "files/test/files-list.e2e-spec.ts",
        "materialized": "test/files-list.e2e-spec.ts",
        "contains": [
