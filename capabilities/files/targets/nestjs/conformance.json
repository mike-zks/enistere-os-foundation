      {
        "kind": "test",
        "source": "files/test/files-upload.e2e-spec.ts",
        "materialized": "test/files-upload.e2e-spec.ts",
        "contains": [
          "no internals exposed"
        ]
      }
    ],
    "FILES-AUTHORITY-003": [
      {
        "kind": "test",
        "source": "files/test/files-upload.e2e-spec.ts",
        "materialized": "test/files-upload.e2e-spec.ts",
        "contains": [
          "rejects content not matching the declared category (real type wins)",
