        ]
      }
    ],
    "FILES-AUTHORITY-004": [
      {
        "kind": "test",
        "source": "files/test/files-upload.e2e-spec.ts",
        "materialized": "test/files-upload.e2e-spec.ts",
        "contains": [
          "stored privately"
        ]
      },
      {
        "kind": "test",
        "source": "files/test/files-download.e2e-spec.ts",
        "materialized": "test/files-download.e2e-spec.ts",
        "contains": [
          "keeps the bucket private: the unsigned object URL is refused"
        ]
      }
    ],
    "FILES-AUTHORITY-005": [
      {
        "kind": "test",
        "source": "files/test/files-download.e2e-spec.ts",
        "materialized": "test/files-download.e2e-spec.ts",
        "contains": [
