// Capability RBAC — rôles, permissions fines et associations (ADR-006).
// Fragment assemblé par la Factory à la suite du schéma base + auth.
//
// Ce fragment ne redéfinit PAS `User` (propriété de la capability Auth) : la
// relation inverse `roles UserRole[]` est ajoutée au modèle existant par
// l'intégration structurée `nestjs.prisma-model-field` déclarée dans overlay.json.
// Les modèles Prisma ne doivent pas être exposés directement comme DTO publics (ADR-002 §20).

/// Rôle RBAC générique (ADR-006). Regroupe des permissions. Aucun rôle métier imposé.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  // Code stable, normalisé (minuscules), identifiant logique du rôle.
  code        String   @unique
  name        String
  description String?
  // Protège les rôles structurels du core (suppression/édition contrôlées à terme).
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Permission fine (ADR-006), convention `resource.action`. Aucune permission métier.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  // Code unique stable au format `resource.action` (minuscules).
  code        String   @unique
  resource    String
  action      String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

/// Association explicite utilisateur ↔ rôle (many-to-many).
model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Clé composite = unicité de l'association + index sur le préfixe userId.
  @@id([userId, roleId])
  // Index complémentaire pour les recherches « utilisateurs d'un rôle ».
  @@index([roleId])
  @@map("user_roles")
}

/// Association explicite rôle ↔ permission (many-to-many).
model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())
  assignedBy   String?  @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Clé composite = unicité + index sur le préfixe roleId.
  @@id([roleId, permissionId])
  // Index complémentaire pour « rôles possédant une permission ».
  @@index([permissionId])
  @@map("role_permissions")
}
