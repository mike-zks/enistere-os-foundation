{
  "schemaVersion": "1",
  "capability": "auth",
  "target": "spring",
  "version": "0.1.0",
  "description": "Auth Spring autonome : login, refresh, logout, session et me.",
  "operations": ["files", "dependencies", "environment", "integrations", "verification"],
  "files": [
    { "source": "files/src/main/java/com/enistere/core/config/Argon2Config.java", "destination": "src/main/java/com/enistere/core/config/Argon2Config.java" },
    { "source": "files/src/main/java/com/enistere/core/config/DatabaseConfig.java", "destination": "src/main/java/com/enistere/core/config/DatabaseConfig.java" },
    { "source": "files/src/main/java/com/enistere/core/config/JwtConfig.java", "destination": "src/main/java/com/enistere/core/config/JwtConfig.java" },
    { "source": "files/src/main/java/com/enistere/core/config/SecurityConfig.java", "destination": "src/main/java/com/enistere/core/config/SecurityConfig.java" },
    { "source": "files/src/main/java/com/enistere/core/infrastructure/persistence/BaseEntity.java", "destination": "src/main/java/com/enistere/core/infrastructure/persistence/BaseEntity.java" },
    { "source": "files/src/main/java/com/enistere/core/infrastructure/security", "destination": "src/main/java/com/enistere/core/infrastructure/security" },
    { "source": "files/src/main/java/com/enistere/core/modules/auth", "destination": "src/main/java/com/enistere/core/modules/auth" },
    { "source": "files/src/main/java/com/enistere/core/modules/users", "destination": "src/main/java/com/enistere/core/modules/users" },
    { "source": "files/src/main/resources/db/migration/V1__init_schema.sql", "destination": "src/main/resources/db/migration/V1__init_schema.sql" },
    { "source": "files/src/main/resources/application.properties", "destination": "src/main/resources/application.properties" },
    { "source": "files/src/test/java/com/enistere/core", "destination": "src/test/java/com/enistere/core" },
    { "source": "files/src/test/resources/application-test.yml", "destination": "src/test/resources/application-test.yml" }
  ],
  "dependencies": {
    "maven": [
      { "groupId": "org.springframework.boot", "artifactId": "spring-boot-starter-security" },
      { "groupId": "org.springframework.boot", "artifactId": "spring-boot-starter-data-jpa" },
      { "groupId": "org.springframework.boot", "artifactId": "spring-boot-starter-flyway" },
      { "groupId": "org.postgresql", "artifactId": "postgresql", "scope": "runtime" },
      { "groupId": "org.flywaydb", "artifactId": "flyway-database-postgresql", "scope": "runtime" },
      { "groupId": "io.jsonwebtoken", "artifactId": "jjwt-api", "version": "0.12.6" },
      { "groupId": "io.jsonwebtoken", "artifactId": "jjwt-impl", "version": "0.12.6", "scope": "runtime" },
      { "groupId": "io.jsonwebtoken", "artifactId": "jjwt-jackson", "version": "0.12.6", "scope": "runtime" },
      { "groupId": "org.bouncycastle", "artifactId": "bcprov-jdk18on", "version": "1.82" },
      { "groupId": "org.springframework.security", "artifactId": "spring-security-test", "scope": "test" },
      { "groupId": "org.springframework.boot", "artifactId": "spring-boot-testcontainers", "scope": "test" },
      { "groupId": "org.testcontainers", "artifactId": "testcontainers-junit-jupiter", "scope": "test" },
      { "groupId": "org.testcontainers", "artifactId": "testcontainers-postgresql", "scope": "test" }
    ]
  },
  "environment": [
    { "name": "JWT_ACCESS_SECRET", "example": "replace-with-at-least-32-random-bytes" },
    { "name": "JWT_ACCESS_EXPIRATION_SECONDS", "example": "900" },
    { "name": "DATABASE_URL", "example": "jdbc:postgresql://localhost:5432/enistere" },
    { "name": "DATABASE_USERNAME", "example": "enistere" },
    { "name": "DATABASE_PASSWORD", "example": "change-me" }
  ],
  "integrations": [
    { "kind": "spring.module", "importPath": "com.enistere.core.config.SecurityConfig", "symbol": "SecurityConfig" }
  ],
  "verification": [["./mvnw", "verify", "--no-transfer-progress"]]
}
