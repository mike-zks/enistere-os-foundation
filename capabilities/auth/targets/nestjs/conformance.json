    "AUTH-AUTHORITY-008": [
      {
        "kind": "test",
        "source": "files/src/auth/auth.service.spec.ts",
        "materialized": "src/auth/auth.service.spec.ts",
        "contains": [
          "AUTH_LOGIN_SUCCEEDED",
          "AUTH_LOGIN_FAILED",
          "AUTH_REFRESH_SUCCEEDED",
