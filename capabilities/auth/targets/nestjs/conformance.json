{
  "schemaVersion": "1",
  "capability": "auth",
  "target": "nestjs",
  "contract": {
    "id": "authentication-product",
    "version": "1.0.0"
  },
  "roles": [
    "authority"
  ],
  "suite": "auth-nestjs-contract",
  "golden": "nestjs-auth",
  "invariants": {
    "AUTH-AUTHORITY-001": [
      {
        "kind": "test",
        "source": "files/test/auth-login.e2e-spec.ts",
