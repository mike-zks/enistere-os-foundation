        "contains": [
          "logs in a valid user",
          "accessToken",
          "refreshToken",
          "passwordHash"
        ]
      }
    ],
    "AUTH-AUTHORITY-002": [
      {
        "kind": "test",
        "source": "files/test/auth-login.e2e-spec.ts",
        "materialized": "test/auth-login.e2e-spec.ts",
        "contains": [
          "rejects a wrong password with a generic error",
          "rejects an unknown email with the same generic error",
          "AUTH_INVALID_CREDENTIALS"
        ]
      }
    ],
    "AUTH-AUTHORITY-003": [
      {
        "kind": "test",
        "source": "files/test/auth-me.e2e-spec.ts",
        "materialized": "test/auth-me.e2e-spec.ts",
        "contains": [
