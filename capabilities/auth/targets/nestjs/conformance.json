          "AUTH_REFRESH_REUSE_DETECTED"
        ]
      }
    ],
    "AUTH-AUTHORITY-005": [
      {
        "kind": "test",
        "source": "files/test/auth-refresh.e2e-spec.ts",
        "materialized": "test/auth-refresh.e2e-spec.ts",
        "contains": [
          "logs out idempotently",
          "refuses subsequent refresh"
        ]
      }
    ],
    "AUTH-AUTHORITY-006": [
      {
        "kind": "test",
        "source": "files/test/auth-login.e2e-spec.ts",
        "materialized": "test/auth-login.e2e-spec.ts",
        "contains": [
          "persists a session with the hash only",
