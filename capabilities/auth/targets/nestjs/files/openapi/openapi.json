{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Statut applicatif général.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/HealthResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Statut applicatif général.",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "health_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Le processus répond.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/LivenessResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Liveness : le processus répond (aucune dépendance externe).",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Dépendances dures disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReadinessResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Une dépendance dure est indisponible (réponse générique).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Readiness : dépendances dures disponibles (PostgreSQL).",
        "tags": [
          "Health"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "auth_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentification réussie : access token et refresh token émis.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Trop de tentatives.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Authentification par identifiants (login).",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "auth_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nouvelle paire de tokens (rotation du refresh token).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/RefreshResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Trop de tentatives.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Rotation du refresh token (nouvelle paire de tokens).",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logout idempotent : la session courante et sa famille sont révoquées.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/LogoutResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Déconnexion idempotente (révocation de la famille de sessions).",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "auth_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Profil public de l’utilisateur authentifié.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "timestamp"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserProfileResponseDto"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-06-09T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise ou session invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Profil public de l’utilisateur authentifié.",
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "info": {
    "title": "Enistere API Core NestJS",
    "description": "Contrat OpenAPI canonique du API Core NestJS V1 — source de vérité des API publiques (ADR-016).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "api-nestjs-core"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-09T12:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ]
      },
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live"
            ],
            "example": "live"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up"
            ],
            "example": "up"
          }
        },
        "required": [
          "database"
        ]
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ],
            "example": "ready"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false,
            "description": "Toujours false pour une réponse d’erreur."
          },
          "statusCode": {
            "type": "number",
            "example": 404,
            "description": "Code de statut HTTP."
          },
          "message": {
            "type": "string",
            "example": "File not found.",
            "description": "Message générique non sensible."
          },
          "errorCode": {
            "type": "string",
            "example": "FILE_NOT_FOUND",
            "description": "Code d’erreur applicatif stable."
          },
          "details": {
            "type": "object",
            "nullable": true,
            "description": "Détails structurés optionnels (ex. erreurs de validation). Jamais de secret ni de stack.",
            "example": null
          },
          "path": {
            "type": "string",
            "example": "/files/123",
            "description": "Chemin de la requête."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-09T12:00:00.000Z"
          },
          "requestId": {
            "type": "string",
            "description": "Identifiant de corrélation de la requête (en-tête X-Request-Id). Pas une donnée de sécurité.",
            "example": "b3f1c2d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d"
          }
        },
        "required": [
          "success",
          "statusCode",
          "message",
          "errorCode",
          "path",
          "timestamp"
        ]
      },
      "UserProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "b3f1c2d4-5e6f-4a8b-9c0d-1e2f3a4b5c6d"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "SUSPENDED"
            ],
            "example": "ACTIVE"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-09T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-09T12:00:00.000Z"
          },
          "deactivatedAt": {
            "type": "object",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfileResponseDto"
          },
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJI...EXAMPLE.access.token",
            "description": "Access token JWT court."
          },
          "refreshToken": {
            "type": "string",
            "example": "8f3a...EXAMPLE.refresh.token",
            "description": "Refresh token opaque (rotation)."
          },
          "accessTokenExpiresIn": {
            "type": "number",
            "example": 900,
            "description": "Durée de vie de l’access token (secondes)."
          },
          "refreshTokenExpiresIn": {
            "type": "number",
            "example": 1209600,
            "description": "Durée de vie du refresh token (secondes)."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken",
          "accessTokenExpiresIn",
          "refreshTokenExpiresIn",
          "tokenType"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "description": "Mot de passe en clair. Jamais journalisé ni renvoyé.",
            "format": "password",
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJI...EXAMPLE.access.token"
          },
          "refreshToken": {
            "type": "string",
            "example": "9c4b...EXAMPLE.refresh.token"
          },
          "accessTokenExpiresIn": {
            "type": "number",
            "example": 900,
            "description": "Durée de vie de l’access token (secondes)."
          },
          "refreshTokenExpiresIn": {
            "type": "number",
            "example": 1209600,
            "description": "Durée de vie du refresh token (secondes)."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresIn",
          "refreshTokenExpiresIn",
          "tokenType"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token opaque délivré au login ou au refresh précédent.",
            "maxLength": 512
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "logged_out"
            ],
            "example": "logged_out"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
