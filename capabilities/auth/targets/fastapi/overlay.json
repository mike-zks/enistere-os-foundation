{
  "schemaVersion": "1",
  "capability": "auth",
  "target": "fastapi",
  "version": "0.2.0",
  "description": "Autorité d'authentification FastAPI : Argon2id, jetons d'accès JWT signés HS256, refresh opaques persistés en empreinte HMAC-SHA256, rotation atomique avec détection de rejeu révoquant la famille, limitation de débit par route, audit métier, migrations Alembic. Apporte aussi l'adapter de persistance que le baseline refuse délibérément de choisir.",
  "files": [
    {
      "source": "files/app/persistence",
      "destination": "app/persistence"
    },
    {
      "source": "files/app/auth",
      "destination": "app/auth"
    },
    {
      "source": "files/migrations/env.py",
      "destination": "migrations/env.py"
    },
    {
      "source": "files/migrations/script.py.mako",
      "destination": "migrations/script.py.mako"
    },
    {
      "source": "files/migrations/versions",
      "destination": "migrations/versions"
    },
    {
      "source": "files/alembic.ini",
      "destination": "alembic.ini"
    },
    {
      "source": "files/tests/auth",
      "destination": "tests/auth"
    }
  ],
  "dependencies": {
    "python": {
      "direct": [
        "alembic==1.18.5",
        "argon2-cffi==25.1.0",
        "asyncpg==0.31.0",
        "PyJWT==2.13.0",
        "SQLAlchemy==2.0.51"
      ],
      "runtime": [
        "alembic==1.18.5",
        "argon2-cffi-bindings==25.1.0",
        "argon2-cffi==25.1.0",
        "asyncpg==0.31.0",
        "cffi==2.1.0",
        "greenlet==3.5.4",
        "Mako==1.3.12",
        "MarkupSafe==3.0.3",
        "pycparser==3.0",
        "PyJWT==2.13.0",
        "SQLAlchemy==2.0.51"
      ],
      "all": [
        "alembic==1.18.5",
        "argon2-cffi-bindings==25.1.0",
        "argon2-cffi==25.1.0",
        "asyncpg==0.31.0",
        "cffi==2.1.0",
        "greenlet==3.5.4",
        "Mako==1.3.12",
        "MarkupSafe==3.0.3",
        "pycparser==3.0",
        "PyJWT==2.13.0",
        "SQLAlchemy==2.0.51"
      ]
    }
  },
  "environment": [
    {
      "name": "JWT_ACCESS_SECRET",
      "example": "change_me_minimum_32_characters_long"
    },
    {
      "name": "REFRESH_TOKEN_HASH_SECRET",
      "example": "change_me_other_minimum_32_characters"
    },
    {
      "name": "ENISTERE_DATABASE_URL",
      "example": "postgresql+asyncpg://enistere:enistere@localhost:5432/enistere"
    }
  ],
  "integrations": [
    {
      "kind": "fastapi.router",
      "importPath": "app.auth",
      "symbol": "router",
      "order": 10
    },
    {
      "kind": "fastapi.lifespan",
      "importPath": "app.persistence.database",
      "symbol": "persistence_lifespan",
      "order": 10
    },
    {
      "kind": "fastapi.exception-handler",
      "importPath": "app.auth",
      "exception": "AuthError",
      "handler": "auth_error_handler",
      "order": 10
    }
  ],
  "verification": [
    [
      "python",
      "-m",
      "pytest",
      "-q"
    ]
  ]
}
