{
  "schemaVersion": "1",
  "capability": "auth",
  "target": "fastapi",
  "version": "0.2.0",
  "description": "Autorit\u00e9 d'authentification FastAPI : Argon2id, jetons d'acc\u00e8s JWT sign\u00e9s HS256, refresh opaques persist\u00e9s en empreinte HMAC-SHA256, rotation atomique avec d\u00e9tection de rejeu r\u00e9voquant la famille, limitation de d\u00e9bit par route, audit m\u00e9tier, migrations Alembic. Apporte aussi l'adapter de persistance que le baseline refuse d\u00e9lib\u00e9r\u00e9ment de choisir.",
  "files": [
    {
      "source": "files/app/modules/auth",
      "destination": "app/modules/auth"
    },
    {
      "source": "files/migrations/versions",
      "destination": "migrations/versions"
    },
    {
      "source": "files/tests/auth",
      "destination": "tests/auth"
    }
  ],
  "dependencies": {
    "python": {
      "direct": [
        "argon2-cffi==25.1.0",
        "PyJWT==2.13.0"
      ],
      "runtime": [
        "argon2-cffi-bindings==25.1.0",
        "argon2-cffi==25.1.0",
        "cffi==2.1.0",
        "pycparser==3.0",
        "PyJWT==2.13.0"
      ],
      "all": [
        "argon2-cffi-bindings==25.1.0",
        "argon2-cffi==25.1.0",
        "cffi==2.1.0",
        "pycparser==3.0",
        "PyJWT==2.13.0"
      ]
    }
  },
  "environment": [
    {
      "name": "JWT_ACCESS_SECRET",
      "example": "change_me_minimum_32_characters_long"
    },
    {
      "name": "REFRESH_TOKEN_HASH_SECRET",
      "example": "change_me_other_minimum_32_characters"
    },
    {
      "name": "ENISTERE_DATABASE_URL",
      "example": "postgresql+asyncpg://enistere:enistere@localhost:5432/enistere"
    }
  ],
  "integrations": [
    {
      "kind": "fastapi.router",
      "importPath": "app.modules.auth",
      "symbol": "router",
      "order": 10
    },
    {
      "kind": "fastapi.lifespan",
      "importPath": "app.persistence.database",
      "symbol": "persistence_lifespan",
      "order": 10
    },
    {
      "kind": "fastapi.exception-handler",
      "importPath": "app.modules.auth",
      "exception": "AuthError",
      "handler": "auth_error_handler",
      "order": 10
    },
    {
      "kind": "fastapi.model-module",
      "importPath": "app.modules.auth.models"
    }
  ],
  "verification": [
    [
      "python",
      "-m",
      "pytest",
      "-q"
    ]
  ]
}
